   "source": [
    "# USE OPTIMAL PARAMETERS FOUND IN TUNING\n",
    "lr = LogisticRegression(l1_ratio=1, C = 0.004832930238571752, max_iter = 1000, random_state=10, solver=\"saga\")\n",
    "\n",
    "pipeline = build_pipeline(lr, cat_cols, dis_cols, scale_cols)\n",
    "\n",
    "cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=10)\n",
    "\n",
    "lr_cross_val_scores = cross_validate(pipeline, X_train, y_train, cv=cv, scoring={\"average_precision\":\"average_precision\", \"roc_auc\":\"roc_auc\", \"neg_brier_score\":\"neg_brier_score\", \"neg_ece\":ece}, return_train_score=True, error_score=\"raise\", verbose=2)"
   ]
  },
