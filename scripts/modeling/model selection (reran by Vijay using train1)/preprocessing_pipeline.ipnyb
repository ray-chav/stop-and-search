   "source": [
    "import matplotlib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "from scipy.special.cython_special import stdtrit\n",
    "from sklearn.base import BaseEstimator, TransformerMixin\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor, HistGradientBoostingRegressor, HistGradientBoostingClassifier\n",
    "from sklearn.metrics import make_scorer, brier_score_loss\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.experimental import enable_iterative_imputer\n",
    "from sklearn.impute import IterativeImputer, SimpleImputer\n",
    "from sklearn.model_selection import StratifiedKFold, cross_validate, GridSearchCV, ParameterGrid\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, OrdinalEncoder, StandardScaler\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.base import clone\n",
    "from scipy import special"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "afadcc09504d6ad3",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-14T02:50:32.496868100Z",
     "start_time": "2026-11-14T02:50:31.952901700Z"
    }
   },
   "outputs": [],
   "source": [
    "train_df = pd.read_csv(\"/Users/halos/Downloads/stop_search_train1.csv\", index_col=0)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2a97589e422711a4",
   "metadata": {},
   "source": [
    "# Preprocessing before pipeline and modeling\n",
    "## We drop unnecessary columns, define categorical and discrete/numerical columns for imputation, and convert categorical variables into strings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9f8015db6ba5f8b3",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-14T02:50:34.906010500Z",
     "start_time": "2026-11-14T02:50:34.836351600Z"
    }
   },
   "outputs": [],
   "source": [
    "# Dropping unnecessary columns for modeling\n",
    "train_date = train_df[\"event_dt\"]\n",
    "train_df = train_df.drop([\"event_dt\", \"orig_age\", \"vital_flag\", \"orig_height\", \"orig_weight\", \"BMI\", \"year\", \"Zone\", \"Latitude\", \"Longitude\", \"SubjectID\"], axis = 1)\n",
    "\n",
    "# Unfloating zip code\n",
    "train_df[\"Zip\"] = train_df[\"Zip\"].astype(\"Int64\")\n",
    "# Defining categorical columns\n",
    "cat_cols = [\"SubjectRace\", \"Zip\", \"District\", \"StopDescription\"]\n",
    "# Defining discrete/numerical columns\n",
    "dis_cols = [\"SubjectGender\", \"SubjectAge\", \"SubjectHeight\", \"SubjectWeight\", \"VehicleYear\", \"SubjectHasPhotoID\", \"hour\", \"night\", \"isDriver\"]\n",
    "# Numerical columns we would like to scale\n",
    "scale_cols = [\"SubjectAge\", \"SubjectHeight\", \"SubjectWeight\", \"VehicleYear\", \"hour\"]\n",
    "# Binary columns\n",
    "bin_cols = [\"SubjectGender\", \"SubjectHasPhotoID\", \"night\", \"isDriver\"]\n",
    "\n",
    "# Converting variables into strings\n",
    "train_df[cat_cols] = train_df[cat_cols].astype(str)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "fe125fcaf47ffb1f",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-14T02:50:37.242093900Z",
     "start_time": "2026-11-14T02:50:37.144473100Z"
    }
   },
   "outputs": [],
   "source": [
    "target = \"search_occurred\"\n",
    "X_train = train_df.drop([target], axis = 1)[cat_cols + dis_cols]\n",
    "y_train = train_df[target]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1c6791c9124f2080",
   "metadata": {},
   "source": [
    "# Defining classes to build pipeline\n",
    "## CatBinner groups sparse labels in categorical variables in an Other category. RoundImputed is used after imputation, to ensure imputed numerical values are discrete"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "8c53c19cda20d30e",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-13T21:08:08.904122900Z",
     "start_time": "2026-11-13T21:08:08.866347500Z"
    }
   },
   "outputs": [],
   "source": [
    "class CatBinner(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, cols, min_freq=0.01, fill_value=\"Other\"):\n",
    "        self.cols = cols\n",
    "        self.min_freq = min_freq\n",
    "        self.fill_value = fill_value\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        self.keep_labels = {}\n",
    "        for c in self.cols:\n",
    "            freq = X[c].value_counts(normalize=True)\n",
    "            self.keep_labels[c] = freq[freq >= self.min_freq].index.tolist()\n",
    "\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        X_copy = X.copy()\n",
    "        for c in self.cols:\n",
    "            labels = self.keep_labels[c]\n",
    "            X_copy[c] = np.where(X_copy[c].isin(labels) | X_copy[c].isna(), X_copy[c], self.fill_value)\n",
    "        return X_copy\n",
    "\n",
    "    def set_output(self, *, transform=None):\n",
    "        return self\n",
    "\n",
    "class RoundImputed(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, cols):\n",
    "        self.cols = cols\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        rounded = X[self.cols].round()\n",
    "        self.min_ = rounded.min()\n",
    "        self.max_ = rounded.max()\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        X_copy = X.copy()\n",
    "        X_copy[self.cols] = X_copy[self.cols].round().clip(self.min_, self.max_, axis=1)\n",
    "        return X_copy\n",
    "\n",
    "    def set_output(self, *, transform=None):\n",
    "        return self\n",
    "\n",
    "class OrdEncoder(BaseEstimator, TransformerMixin):\n",
    "    def __init__(self, cat_cols, inner):\n",
    "        self.cat_cols = cat_cols\n",
    "        self.inner = inner\n",
    "\n",
    "    def _encode(self, X):\n",
    "        X_enc = X.copy()\n",
    "        X_enc[self.cat_cols] = self.encoder_.transform(X[self.cat_cols])\n",
    "        return X_enc\n",
    "\n",
    "    def _decode(self, X_imp):\n",
    "        X_dec = X_imp.copy()\n",
    "        X_dec[self.cat_cols] = self.encoder_.inverse_transform(X_imp[self.cat_cols])\n",
    "        return X_dec\n",
    "\n",
    "    def fit_transform(self, X, y=None):\n",
    "        self.encoder_ = OrdinalEncoder(handle_unknown=\"use_encoded_value\", unknown_value=np.nan)\n",
    "        self.encoder_.fit(X[self.cat_cols])\n",
    "        self.inner_ = clone(self.inner)\n",
    "        return self._decode(self.inner_.fit_transform(self._encode(X), y))\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        self.fit_transform(X, y)\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        return self._decode(self.inner_.transform(self._encode(X)))\n",
    "\n",
    "    def set_output(self, *, transform=None):\n",
    "        return self"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ae8731c6b05a5e12",
   "metadata": {},
   "source": [
    "# Building pipeline\n",
    "## Define a function to construct pipeline given model, and discrete and categorical columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "493fe8532a5eb10",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-13T21:08:14.927903300Z",
     "start_time": "2026-11-13T21:08:14.901796Z"
    }
   },
   "outputs": [],
   "source": [
    "def build_pipeline(model, cat_cols, dis_cols, scale_cols):\n",
    "    imputer = IterativeImputer(estimator=HistGradientBoostingRegressor(max_iter=50, random_state=10), skip_complete=True, max_iter=5, tol=1e-2, random_state=10)\n",
    "\n",
    "    impute = Pipeline([\n",
    "        (\"imputer\", imputer),\n",
    "        (\"round\", RoundImputed(cols=cat_cols + dis_cols)),\n",
    "    ])\n",
    "\n",
    "    impute.set_output(transform=\"pandas\")\n",
    "\n",
    "    encode = ColumnTransformer([(\"encode\", OneHotEncoder(handle_unknown=\"ignore\"), cat_cols), (\"scale\", StandardScaler(), scale_cols)], remainder=\"passthrough\", verbose_feature_names_out=False)\n",
    "\n",
    "    pipeline = Pipeline([\n",
    "        (\"bin\", CatBinner(cols=cat_cols, min_freq=0.01, fill_value=\"Other\")),\n",
    "        (\"imputer\", OrdEncoder(cat_cols, impute)),\n",
    "        (\"encode\", encode),\n",
    "        (\"model\", model)\n",
    "    ], memory=\"cache_dir\")\n",
    "\n",
    "    return pipeline"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c7f0ccff866ee377",
   "metadata": {},
   "source": [
    "## Defining ECE scorer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "c448ea4d25141ff4",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-14T02:50:45.223390300Z",
     "start_time": "2026-11-14T02:50:45.160859900Z"
    }
   },
   "outputs": [],
   "source": [
    "def expected_calibration_error(y_true, y_prob, n_bins=20):\n",
    "    bin_edges = np.linspace(0, 1, n_bins + 1)\n",
    "    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
    "    ece = 0.0\n",
    "    for i in range(n_bins):\n",
    "        bin_mask = (y_prob >= bin_edges[i]) & (y_prob <= bin_edges[i + 1])\n",
    "        if np.any(bin_mask):\n",
    "            bin_accuracy = np.mean(y_true[bin_mask])\n",
    "            bin_confidence = bin_centers[i]\n",
    "            ece += np.abs(bin_confidence - bin_accuracy) * np.sum(bin_mask)\n",
    "    ece /= y_true.size\n",
    "    return ece\n",
    "\n",
    "ece = make_scorer(expected_calibration_error, greater_is_better=False, response_method=\"predict_proba\", n_bins = 20)"
   ]
  },
  {
