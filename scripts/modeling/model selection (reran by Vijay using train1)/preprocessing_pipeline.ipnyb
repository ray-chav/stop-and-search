   "id": "c910438dfb16da1f",
   "metadata": {},
   "source": [
    "## Decision Tree"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "4a9e0300c3597c1c",
   "metadata": {
