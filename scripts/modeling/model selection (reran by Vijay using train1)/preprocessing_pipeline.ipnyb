      "[CV] END .................................................... total time=  33.1s\n"
     ]
    }
   ],
   "source": [
    "rf = RandomForestClassifier(criterion=\"gini\", max_depth=None, min_samples_split=13, min_samples_leaf=11, max_features=\"log2\", random_state=10)\n",
    "\n",
    "pipeline = build_pipeline(rf, cat_cols, dis_cols, scale_cols)\n",
    "\n",
    "cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=10)\n",
    "\n",
    "rf_cross_val_scores = cross_validate(pipeline, X_train, y_train, cv=cv, scoring={\"average_precision\":\"average_precision\", \"roc_auc\":\"roc_auc\", \"neg_brier_score\":\"neg_brier_score\", \"neg_ece\":ece}, return_train_score=True, error_score=\"raise\", verbose=2)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5d33d18ec29bab96",
   "metadata": {},
   "source": [
    "# Evaluating metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "642883f065ebdc85",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-14T03:04:33.707881500Z",
     "start_time": "2026-11-14T03:04:33.646113100Z"
    }
   },
   "outputs": [],
   "source": [
    "# Saving results\n",
    "lr_scores = pd.DataFrame(lr_cross_val_scores)\n",
    "dt_scores = pd.DataFrame(dt_cross_val_scores)\n",
    "rf_scores = pd.DataFrame(rf_cross_val_scores)\n",
    "\n",
    "# Making brier and ece nonnegative\n",
    "lr_scores[\"test_brier_score\"], lr_scores[\"train_brier_score\"], lr_scores[\"test_ece\"], lr_scores[\"train_ece\"] = -lr_scores[\"test_neg_brier_score\"], -lr_scores[\"train_neg_brier_score\"], -lr_scores[\"test_neg_ece\"], -lr_scores[\"train_neg_ece\"]\n",
    "\n",
    "dt_scores[\"test_brier_score\"], dt_scores[\"train_brier_score\"], dt_scores[\"test_ece\"], dt_scores[\"train_ece\"] = -dt_scores[\"test_neg_brier_score\"], -dt_scores[\"train_neg_brier_score\"], -dt_scores[\"test_neg_ece\"], -dt_scores[\"train_neg_ece\"]\n",
    "\n",
    "rf_scores[\"test_brier_score\"], rf_scores[\"train_brier_score\"], rf_scores[\"test_ece\"], rf_scores[\"train_ece\"] = -rf_scores[\"test_neg_brier_score\"], -rf_scores[\"train_neg_brier_score\"], -rf_scores[\"test_neg_ece\"], -rf_scores[\"train_neg_ece\"]\n",
    "\n",
    "# Creating standard deviation and error columns\n",
    "t_alpha = special.stdtrit(len(lr_scores)-1, 0.975)\n",
    "summary_lr = (lr_scores.agg([\"mean\", \"std\"]).T.reset_index())\n",
    "summary_lr.columns = [\"metric\", \"lr_mean\", \"lr_std\"]\n",
    "summary_lr[\"lr_se\"] = summary_lr[\"lr_std\"]/np.sqrt(len(lr_scores))\n",
    "summary_lr[\"lr_lower_95_ci\"] = summary_lr[\"lr_mean\"] - t_alpha*summary_lr[\"lr_se\"]\n",
    "summary_lr[\"lr_upper_95_ci\"] = summary_lr[\"lr_mean\"] + t_alpha*summary_lr[\"lr_se\"]\n",
    "\n",
    "summary_dt = (dt_scores.agg([\"mean\", \"std\"]).T.reset_index())\n",
    "summary_dt.columns = [\"metric\", \"dt_mean\", \"dt_std\"]\n",
    "summary_dt[\"dt_se\"] = summary_dt[\"dt_std\"]/np.sqrt(len(dt_scores))\n",
    "summary_dt[\"dt_lower_95_ci\"] = summary_dt[\"dt_mean\"] - t_alpha*summary_dt[\"dt_se\"]\n",
    "summary_dt[\"dt_upper_95_ci\"] = summary_dt[\"dt_mean\"] + t_alpha*summary_dt[\"dt_se\"]\n",
    "\n",
    "summary_rf = (rf_scores.agg([\"mean\", \"std\"]).T.reset_index())\n",
    "summary_rf.columns = [\"metric\", \"rf_mean\", \"rf_std\"]\n",
    "summary_rf[\"rf_se\"] = summary_rf[\"rf_std\"]/np.sqrt(len(rf_scores))\n",
    "summary_rf[\"rf_lower_95_ci\"] = summary_rf[\"rf_mean\"] - t_alpha*summary_rf[\"rf_se\"]\n",
    "summary_rf[\"rf_upper_95_ci\"] = summary_rf[\"rf_mean\"] + t_alpha*summary_rf[\"rf_se\"]"
   ]
  },
