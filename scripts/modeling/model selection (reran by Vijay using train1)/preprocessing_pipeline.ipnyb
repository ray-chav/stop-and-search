   "source": [
    "fig, axs = plt.subplots(2,2, figsize=(15,10))\n",
    "\n",
    "sns.boxplot(scores, x = \"Model\", y = \"test_average_precision\", order=[\"Logistic Regression\", \"Decision Tree\", \"Random Forest\"], ax = axs[0,0])\n",
    "axs[0,0].set_ylabel(\"Validation PR-AUC/Average Precision\", fontsize=12)\n",
    "axs[0,0].set_title(\"PR-AUC\", fontsize=14)\n",
    "\n",
    "sns.boxplot(scores, x = \"Model\", y = \"test_brier_score\", order=[\"Logistic Regression\", \"Decision Tree\", \"Random Forest\"], ax = axs[0,1])\n",
    "axs[0,1].set_ylabel(\"Validation Brier Score\", fontsize=12)\n",
    "axs[0,1].set_title(\"Brier Score\", fontsize=14)\n",
    "\n",
    "sns.boxplot(scores, x = \"Model\", y = \"test_roc_auc\", order=[\"Logistic Regression\", \"Decision Tree\", \"Random Forest\"], ax = axs[1,0])\n",
    "axs[1,0].set_ylabel(\"Validation ROC-AUC\", fontsize=12)\n",
    "axs[1,0].set_title(\"ROC-AUC\", fontsize=14)\n",
    "\n",
    "sns.boxplot(scores, x = \"Model\", y = \"test_ece\", order=[\"Logistic Regression\", \"Decision Tree\", \"Random Forest\"], ax = axs[1,1])\n",
    "axs[1,1].set_ylabel(\"Validation Expected Calibration Error\", fontsize=12)\n",
    "axs[1,1].set_title(\"Expected Calibration Error\", fontsize=14)\n",
    "\n",
    "plt.suptitle(\"10-Fold CV Performance Metrics of Models\", fontsize=30)\n",
    "plt.savefig(r\"/Users/halos/Downloads/cv_models_boxplot.png\", bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  }
