   "source": [
    "lr_scores[\"Model\"] = \"Logistic Regression\"\n",
    "dt_scores[\"Model\"] = \"Decision Tree\"\n",
    "rf_scores[\"Model\"] = \"Random Forest\"\n",
    "scores = pd.concat([lr_scores, dt_scores, rf_scores])\n",
    "scores"
   ]
  },
