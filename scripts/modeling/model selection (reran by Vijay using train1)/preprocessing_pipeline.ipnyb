   "source": [
    "dt = DecisionTreeClassifier(criterion = \"entropy\", max_depth = 9, min_samples_leaf = 31, min_samples_split = 29, random_state=10)\n",
    "\n",
    "pipeline = build_pipeline(dt, cat_cols, dis_cols, scale_cols)\n",
    "\n",
    "cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=10)\n",
    "\n",
    "dt_cross_val_scores = cross_validate(pipeline, X_train, y_train, cv=cv, scoring={\"average_precision\":\"average_precision\", \"roc_auc\":\"roc_auc\", \"neg_brier_score\":\"neg_brier_score\", \"neg_ece\":ece}, return_train_score=True, error_score=\"raise\", verbose=2)"
   ]
  },
